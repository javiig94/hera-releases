# Copia este archivo a .env y rellena

# Clave secreta de Stripe (Dashboard → Developers → API keys). Usa sk_test_... para probar, sk_live_... para vender.
STRIPE_SECRET_KEY=sk_test_xxx

# Opcional pero recomendado: firma del webhook (Dashboard → Developers → Webhooks → endpoint https://TUDOMINIO/webhook, evento checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# URL pública de la web, sin barra final
SITE_URL=https://spelloraguides.com

# Precios en centavos de dólar
PRICE_BOOK=2999        # libro + Protocolo 2 a.m. ($29.99)
PRICE_SCRIPTS=1700     # Scripts Pack: order bump en la caja de compra y upsell de un clic tras pagar ($17)

# Meta Conversions API (Events Manager → tu píxel → Settings → Conversions API → Generate access token)
META_PIXEL_ID=
META_CAPI_TOKEN=
# Opcional, solo para probar: Events Manager → Test events → código tipo TEST12345. Quítalo al lanzar.
META_TEST_EVENT_CODE=

# Cualquier cadena larga aleatoria. Firma los enlaces de descarga. NO la cambies después de vender (invalidaría los enlaces).
DOWNLOAD_SECRET=cambia_esto_por_64_caracteres_aleatorios

# Días que vale el enlace de descarga
LINK_VALID_DAYS=30

PORT=3000
